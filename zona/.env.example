# Токен бота от @BotFather
BOT_TOKEN=
# Публичный HTTPS-адрес, где запущен сервер (он же адрес Mini App)
PUBLIC_URL=https://zona.example.com
PORT=8080
# Telegram ID админов через запятую: им доступна команда /stats
ADMIN_IDS=
# Путь к базе (по умолчанию ./data/zona.db)
# DB_PATH=/var/lib/zona/zona.db
# Только для локальной отладки в браузере без Telegram! В продакшене не включать.
# DEV_AUTH=1
