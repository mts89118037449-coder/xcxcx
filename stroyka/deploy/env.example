# Скопируйте в stroyka/.env и заполните.

# Источник данных — Google-таблица «Glorax_Учёт».
# proxy      — (основной) всё читается и пишется в Google-таблицу, сервер держит её копию
# standalone — только на случай блокировки Google: данные на этом сервере
MODE=proxy

# Ссылка …/exec веб-приложения Apps Script. Если задана — сервер каждые 5 минут
# снимает копию таблицы в data/backups (в обоих режимах).
GOOGLE_API_URL=
GOOGLE_TOKEN=
MIRROR_MINUTES=5

# Пароль на API (необязательно). Тогда в приложении: «Таблица…» → поле «Токен».
API_TOKEN=

# Сколько файлов бэкапа хранить (≈ 400 — больше двух недель при ежечасных снимках)
BACKUP_KEEP=400
PORT=8080
