[Unit]
Description=Stroyka 3D — сервер приложения
After=network-online.target
Wants=network-online.target

[Service]
User=stroyka
WorkingDirectory=/opt/stroyka/stroyka
EnvironmentFile=/opt/stroyka/stroyka/.env
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
