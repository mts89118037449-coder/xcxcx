<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 в фирменных цветах SoundAura. Фон окна — с мягким свечением ауры. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_onPrimary</item>
        <item name="colorPrimaryContainer">@color/m3_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/m3_onPrimaryContainer</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_onSecondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/m3_onSecondaryContainer</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_onTertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/m3_onTertiaryContainer</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_onError</item>
        <item name="colorErrorContainer">@color/m3_errorContainer</item>
        <item name="colorOnErrorContainer">@color/m3_onErrorContainer</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_onBackground</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_onSurface</item>
        <item name="colorSurfaceVariant">@color/m3_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/m3_onSurfaceVariant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outlineVariant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/m3_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surfaceContainerHighest</item>
        <item name="actionMenuTextAppearance">@style/MenuText</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowBackground">@color/m3_background</item>
        <!-- Onest для заголовков, текста и подписей -->
        <item name="android:fontFamily">@font/onest</item>
        <item name="fontFamily">@font/onest</item>
        <item name="textAppearanceDisplaySmall">@style/TA.Display</item>
        <item name="textAppearanceHeadlineLarge">@style/TA.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TA.Headline</item>
        <item name="textAppearanceHeadlineSmall">@style/TA.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TA.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TA.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TA.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TA.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TA.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TA.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TA.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TA.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TA.LabelSmall</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/m3_background</item>
    </style>

    <!-- Типографика SoundAura -->
    <style name="TA.Display" parent="TextAppearance.Material3.DisplaySmall"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="TA.Headline" parent="TextAppearance.Material3.HeadlineMedium"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="TA.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="TA.TitleLarge" parent="TextAppearance.Material3.TitleLarge"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item></style>
    <style name="TA.TitleMedium" parent="TextAppearance.Material3.TitleMedium"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item></style>
    <style name="TA.TitleSmall" parent="TextAppearance.Material3.TitleSmall"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item><item name="android:textSize">15sp</item></style>
    <style name="TA.BodyLarge" parent="TextAppearance.Material3.BodyLarge"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item></style>
    <style name="TA.BodyMedium" parent="TextAppearance.Material3.BodyMedium"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item></style>
    <style name="TA.BodySmall" parent="TextAppearance.Material3.BodySmall"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textSize">13sp</item></style>
    <style name="TA.LabelLarge" parent="TextAppearance.Material3.LabelLarge"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item></style>
    <style name="TA.LabelMedium" parent="TextAppearance.Material3.LabelMedium"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item></style>
    <style name="TA.LabelSmall" parent="TextAppearance.Material3.LabelSmall"><item name="android:fontFamily">@font/onest</item><item name="fontFamily">@font/onest</item><item name="android:textStyle">bold</item></style>

    <!-- Прозрачное окно, поверх которого выезжает нижняя панель «Поделиться». -->
    <style name="ShareTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textAppearance">@style/TA.TitleLarge</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="MenuText" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="MiniCoverShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="JobCoverShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="DiscShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="WaveCoverShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <style name="NowPlayingCoverShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="CoverShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="CardCoverShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="AuraGlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">#B8151522</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#26FFFFFF</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>
    <style name="PlayerControl">
        <item name="android:layout_width">@dimen/player_control_size</item>
        <item name="android:layout_height">@dimen/player_control_size</item>
        <item name="android:background">@drawable/bg_glass_circle</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
