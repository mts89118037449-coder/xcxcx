<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка: тёмная поверхность с тонкой линией и яркой рамкой при фокусе пульта -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#2EFFFFFF" />
            <stroke android:width="2dp" android:color="#FFB388FF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
