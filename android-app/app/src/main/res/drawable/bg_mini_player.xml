<?xml version="1.0" encoding="utf-8"?>
<!-- Мини-плеер: тёмное стекло с градиентной каймой ауры -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="20dp" />
            <gradient android:angle="0" android:startColor="#FF6A3DF0" android:endColor="#FFFF4F9A" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape>
            <corners android:radius="19dp" />
            <gradient android:angle="0" android:startColor="@color/mini_start" android:endColor="@color/mini_end" />
        </shape>
    </item>
</layer-list>
