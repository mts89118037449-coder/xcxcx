<?xml version="1.0" encoding="utf-8"?>
<!-- Главная кнопка «Слушать»: градиент ауры -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="100dp" />
            <gradient android:angle="0" android:startColor="#FF7A4FF8" android:centerColor="#FFB452D4" android:endColor="#FFFF66AA" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <ripple android:color="#40FFFFFF">
            <item>
                <shape>
                    <corners android:radius="100dp" />
                    <gradient android:angle="0" android:startColor="#FF6A3DF0" android:centerColor="#FFA843C8" android:endColor="#FFFF4F9A" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
