<?xml version="1.0" encoding="utf-8"?>
<!-- Фон приложения: тёмный (или светлый) с мягким свечением ауры по углам -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/m3_background" /></shape></item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="420dp" android:centerX="0.0" android:centerY="0.0"
                android:startColor="@color/aura_glow_violet" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:type="radial" android:gradientRadius="380dp" android:centerX="1.0" android:centerY="0.18"
                android:startColor="@color/aura_glow_pink" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
