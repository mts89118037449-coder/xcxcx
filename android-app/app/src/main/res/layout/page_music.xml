<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <!-- Шапка: знак SoundAura, приветствие, кнопка поиска -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo_mark" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/brandGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/brandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SoundAura"
                    android:textAppearance="@style/TA.HeadlineSmall"
                    android:textSize="20sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/searchOpen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="Поиск"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/musicSearchLayout"
            style="?attr/textInputOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Песни, исполнители, альбомы"
            android:visibility="gone"
            app:boxBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="1.5dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/musicSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/musicLinkActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/searchBrowser"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Искать в браузере" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addMusicLink"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Добавить ссылку" />
        </LinearLayout>

        <!-- Результаты поиска -->
        <LinearLayout
            android:id="@+id/musicResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/musicProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                app:trackCornerRadius="4dp" />

            <LinearLayout
                android:id="@+id/searchShelves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/catalogTitle"
                style="@style/SectionTitle"
                android:text="Песни" />

            <TextView
                android:id="@+id/catalogEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="В каталогах ничего не нашлось — смотрите ниже"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/catalogList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionTitle"
                    android:text="Открытые источники" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/webProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    app:indicatorSize="18dp"
                    app:trackThickness="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/webHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SoundCloud, Hitmotop, YouTube и другие"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/webList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Главная: чарт, альбомы, исполнители -->
        <LinearLayout
            android:id="@+id/homeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
