<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="2dp"
    android:gravity="center"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/npLike"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="В любимое"
        android:focusable="true"
        android:nextFocusRight="@+id/npPrev"
        android:src="@drawable/ic_favorite_border"
        app:tint="?attr/colorOnSurface" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/npPrev"
        style="?attr/materialIconButtonStyle"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Предыдущая"
        android:focusable="true"
        android:nextFocusLeft="@+id/npLike"
        android:nextFocusRight="@+id/npPlay"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_skip_previous"
        app:iconSize="34dp"
        app:iconTint="?attr/colorOnSurface" />

    <include layout="@layout/np_play_button" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/npNext"
        style="?attr/materialIconButtonStyle"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_glass_circle"
        android:contentDescription="Следующая"
        android:focusable="true"
        android:nextFocusLeft="@+id/npPlay"
        android:nextFocusRight="@+id/npSpeed"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_skip_next"
        app:iconSize="34dp"
        app:iconTint="?attr/colorOnSurface" />

    <Button
        android:id="@+id/npSpeed"
        style="?attr/borderlessButtonStyle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_circle"
        android:focusable="true"
        android:minWidth="0dp"
        android:nextFocusLeft="@+id/npNext"
        android:padding="0dp"
        android:text="1×"
        android:textAllCaps="false"
        app:backgroundTint="@null" />
</LinearLayout>
