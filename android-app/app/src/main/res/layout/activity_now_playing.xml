<?xml version="1.0" encoding="utf-8"?>
<!-- Плеер, вариант «Кольцо»: обложка-диск, прогресс — градиентное кольцо ауры вокруг неё -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Свет от обложки: её цвет, размытый, сверху -->
    <View
        android:id="@+id/npBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/npAura"
        android:layout_width="match_parent"
        android:layout_height="560dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="2dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <include layout="@layout/np_top_bar" />

                <FrameLayout
                    android:id="@+id/npCoverBox"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:id="@+id/npCoverFrame"
                        android:layout_width="276dp"
                        android:layout_height="276dp"
                        android:layout_gravity="center">

                        <com.zagruzchik.app.RingProgressView
                            android:id="@+id/npSeek"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Перемотка" />

                        <ImageView
                            android:id="@+id/npCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="34dp"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop" />

                        <View
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:background="@drawable/disc_hole" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/npPos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:text="/"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/npDur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/npTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="@style/TA.HeadlineSmall"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/npArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/npSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </ScrollView>

        <include
            layout="@layout/np_bottom_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <include layout="@layout/np_transport" />

    </LinearLayout>
</FrameLayout>
