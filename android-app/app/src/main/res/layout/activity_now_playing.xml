<?xml version="1.0" encoding="utf-8"?>
<!-- Плеер, вариант «Кольцо»: обложка-диск, прогресс — градиентное кольцо ауры вокруг неё -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Свет от обложки: её цвет, размытый, сверху -->
    <View
        android:id="@+id/npBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/npAura"
        android:layout_width="match_parent"
        android:layout_height="560dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingBottom="18dp">

        <include layout="@layout/np_top_bar" />

        <FrameLayout
            android:id="@+id/npCoverBox"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="240dp">

            <FrameLayout
                android:id="@+id/npCoverFrame"
                android:layout_width="320dp"
                android:layout_height="320dp"
                android:layout_gravity="center">

                <com.zagruzchik.app.RingProgressView
                    android:id="@+id/npSeek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Перемотка" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/npCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="34dp"
                    android:elevation="10dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/DiscShape" />

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:background="@drawable/disc_hole"
                    android:elevation="11dp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/npPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:text="/"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/npDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/npTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TA.HeadlineSmall"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/npArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/npSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/npLike"
                style="?attr/materialIconButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="В любимое"
                app:icon="@drawable/ic_favorite_border"
                app:iconSize="26dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/npPrev"
                style="?attr/materialIconButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Предыдущая"
                app:icon="@drawable/ic_skip_previous"
                app:iconSize="34dp"
                app:iconTint="?attr/colorOnSurface" />

            <include layout="@layout/np_play_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/npNext"
                style="?attr/materialIconButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Следующая"
                app:icon="@drawable/ic_skip_next"
                app:iconSize="34dp"
                app:iconTint="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/npRepeat"
                style="?attr/materialIconButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Повтор"
                app:icon="@drawable/ic_repeat"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- «Перемешать» в этом варианте живёт в нижней панели -->
        <include layout="@layout/np_status" />
        <include layout="@layout/np_actions_ring" />
    </LinearLayout>
</FrameLayout>
