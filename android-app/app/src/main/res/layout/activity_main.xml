<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aura"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="SoundAura"
            app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/pageDownload"
                layout="@layout/page_download" />

            <include
                android:id="@+id/pageMusic"
                layout="@layout/page_music"
                android:visibility="gone" />

            <include
                android:id="@+id/pageLibrary"
                layout="@layout/page_library"
                android:visibility="gone" />

            <include
                android:id="@+id/pageJobs"
                layout="@layout/page_jobs"
                android:visibility="gone" />

            <include
                android:id="@+id/pageSettings"
                layout="@layout/page_settings"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Мини-проигрыватель: тёмная карточка, слева — свечение в цвет обложки,
             вокруг кнопки «пауза» — кольцо прогресса ауры -->
        <FrameLayout
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_mini_player"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:id="@+id/miniGlow"
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/miniCover"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    app:shapeAppearanceOverlay="@style/MiniCoverShape" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/miniTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/miniArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <com.zagruzchik.app.RingProgressView
                        android:id="@+id/miniRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/miniPlay"
                        style="?attr/materialIconButtonStyle"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="Пауза"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_pause"
                        app:iconTint="?attr/colorOnSurface" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/miniNext"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Следующая"
                    app:icon="@drawable/ic_skip_next"
                    app:iconTint="?attr/colorOnSurface" />
            </LinearLayout>

            <com.zagruzchik.app.AuraProgressLine
                android:id="@+id/miniProgressLine"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom" />
        </FrameLayout>

        <!-- Нижнее меню: плавающая «таблетка» -->
        <com.zagruzchik.app.PillNav
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
