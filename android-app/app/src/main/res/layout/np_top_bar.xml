<?xml version="1.0" encoding="utf-8"?>
<!-- Верх плеера: свернуть · «Играет из …» · трансляция и поделиться -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/npClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_glass_soft"
        android:contentDescription="Свернуть"
        android:src="@drawable/ic_expand_more"
        app:tint="?attr/colorOnSurface" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <com.zagruzchik.app.EqBarsView
                android:id="@+id/npEq"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/npHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:text="Сейчас играет"
                android:textAppearance="?attr/textAppearanceLabelLarge" />
        </LinearLayout>
    </FrameLayout>

    <androidx.mediarouter.app.MediaRouteButton
        android:id="@+id/npCast"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/npShare"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Поделиться"
        android:src="@drawable/ic_share"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/npMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ещё"
        android:src="@drawable/ic_more_horiz"
        app:tint="?attr/colorOnSurface" />
</LinearLayout>
