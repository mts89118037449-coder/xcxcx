<?xml version="1.0" encoding="utf-8"?>
<!-- Действия и текущий источник -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/player_control_size"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/npClose"
        style="@style/PlayerControl"
        android:contentDescription="Свернуть"
        android:src="@drawable/ic_expand_more"
        app:tint="?attr/colorOnSurface" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <com.zagruzchik.app.EqBarsView
                android:id="@+id/npEq"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/npHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:text="Сейчас играет"
                android:textAppearance="?attr/textAppearanceLabelLarge" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/npCastSlot"
        android:layout_width="@dimen/player_control_size"
        android:layout_height="@dimen/player_control_size"
        android:visibility="gone">

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/npCast"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_glass_circle"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/npEqualizer"
        style="@style/PlayerControl"
        android:layout_marginStart="@dimen/player_control_gap"
        android:contentDescription="Эквалайзер"
        android:focusable="true"
        android:nextFocusRight="@+id/npMore"
        android:src="@drawable/ic_equalizer"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/npMore"
        style="@style/PlayerControl"
        android:layout_marginStart="@dimen/player_control_gap"
        android:contentDescription="Ещё"
        android:nextFocusLeft="@id/npEqualizer"
        android:src="@drawable/ic_more_horiz"
        app:tint="?attr/colorOnSurface" />
</LinearLayout>
