<?xml version="1.0" encoding="utf-8"?>
<!-- Нижняя панель плеера: действия с песней -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_glass_pill_big"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <LinearLayout
        android:id="@+id/npLyrics"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/npLyricsIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lyrics"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/npLyricsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="Текст"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/npShuffle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/npShuffleIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_shuffle"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/npShuffleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="Микс"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/npWhere"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/npWhereIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_link"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/npWhereText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="Сервисы"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/npDownload"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/npDownloadIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_download"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/npDownloadText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="Скачать"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/npShare"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/npShareIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_send"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/npShareText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:text="Отправить"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </LinearLayout>
</LinearLayout>
