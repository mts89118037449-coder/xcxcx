<?xml version="1.0" encoding="utf-8"?>
<!-- Текст песни прямо в плеере: строки идут вместе с музыкой; нажатие — весь текст (караоке) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/npLyricsPeek"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_glass_pill_big"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="14dp"
    android:visibility="gone">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/npLyrPrev"
        android:layout_width="match_parent"
        android:layout_height="22sp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="15sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="13sp"
        app:autoSizeMaxTextSize="15sp"
        app:autoSizeStepGranularity="1sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/npLyrNow"
        android:layout_width="match_parent"
        android:layout_height="48sp"
        android:layout_marginVertical="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/onest"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textFontWeight="700"
        android:textSize="20sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="15sp"
        app:autoSizeMaxTextSize="20sp"
        app:autoSizeStepGranularity="1sp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/npLyrNext"
        android:layout_width="match_parent"
        android:layout_height="37sp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="15sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="13sp"
        app:autoSizeMaxTextSize="15sp"
        app:autoSizeStepGranularity="1sp"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
