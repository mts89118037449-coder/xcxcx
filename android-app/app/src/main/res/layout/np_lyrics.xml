<?xml version="1.0" encoding="utf-8"?>
<!-- Текст песни прямо в плеере: строки идут вместе с музыкой; нажатие — весь текст (караоке) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/npLyricsPeek"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_glass_pill_big"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingVertical="8dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/npLyrPrev"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:lines="1"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/npLyrNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/onest"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textFontWeight="700"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/npLyrNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
